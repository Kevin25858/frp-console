# FRP Console 环境变量配置文件
# 复制此文件为 .env 并修改为你自己的配置

# ==================== 必需配置 ====================

# 管理员密码（必需，建议长度至少 16 位）
ADMIN_PASSWORD=change_me_to_a_strong_password

# Flask 密钥（必需，用于会话加密，建议随机生成）
# 生成命令: openssl rand -hex 32
SECRET_KEY=change_me_to_a_random_secret_key

# API Token（必需，用于 frpc 拉取配置）
# 生成命令: openssl rand -hex 16
API_TOKEN=change_me_to_a_random_api_token

# ==================== 基础配置 ====================

# 服务端口（默认 7600）
PORT=7600

# 时区（默认 Asia/Shanghai）
TZ=Asia/Shanghai

# 管理员用户名（默认 admin）
ADMIN_USER=admin

# ==================== Docker 配置 ====================

# 宿主机 docker 组的 GID（Web 容器需加入此组以读写 docker.sock）
# 宿主机执行: stat -c '%g' /var/run/docker.sock 获取
# 或执行: bash install.sh 自动探测
DOCKER_GID=999

# npm 镜像源（构建前端用时，国内可设为 https://registry.npmmirror.com）
NPM_REGISTRY=https://registry.npmjs.org

# ==================== 可选：安全配置 ====================

# Flask 环境（production/development，默认 production）
FLASK_ENV=production

# 是否强制使用 HTTPS（默认 false）
FORCE_HTTPS=false
