# FRP Console 环境变量配置文件
# 复制此文件为 .env 并修改为你自己的配置

# ==================== 必需配置 ====================

# 管理员密码（必需，建议长度至少 16 位）
ADMIN_PASSWORD=change_me_to_a_strong_password

# Flask 密钥（必需，用于会话加密，建议随机生成）
# 生成命令: openssl rand -hex 32
SECRET_KEY=change_me_to_a_random_secret_key

# API Token（必需，用于 frpc 拉取配置）
# 生成命令: openssl rand -hex 16
API_TOKEN=change_me_to_a_random_api_token

# ==================== 基础配置 ====================

# 服务端口（默认 7600）
PORT=7600

# 时区（默认 Asia/Shanghai）
TZ=Asia/Shanghai

# 管理员用户名（默认 admin）
ADMIN_USER=admin

# ==================== 可选：SMTP 邮件告警配置 ====================

# SMTP 服务器地址
# SMTP_HOST=smtp.qq.com

# SMTP 端口（默认 587）
# SMTP_PORT=587

# SMTP 用户名
# SMTP_USER=your_email@qq.com

# SMTP 密码（通常是授权码）
# SMTP_PASSWORD=your_smtp_password

# 告警接收邮箱（多个用逗号分隔）
# ALERT_TO=alert@example.com,admin@example.com

# ==================== 可选：Webhook 告警配置 ====================

# Webhook URL
# WEBHOOK_URL=https://hooks.example.com/alerts

# 是否启用 Webhook（默认 false）
# WEBHOOK_ENABLED=false

# ==================== 可选：安全配置 ====================

# Flask 环境（production/development，默认 production）
FLASK_ENV=production

# 是否强制使用 HTTPS（默认 false）
FORCE_HTTPS=false

# CORS 允许的源（留空表示只允许同源，多个用逗号分隔）
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://example.com

# ==================== 可选：GitHub 更新检查配置 ====================

# 自动检查更新（默认 true）
# CHECK_UPDATES=true

# GitHub Token（如需检查私有仓库或避免 API 限制）
# GITHUB_TOKEN=your_github_token
