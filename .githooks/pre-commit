#!/bin/bash
# pre-commit hook - 检查提交作者信息

CORRECT_NAME="Kevin25858"
CORRECT_EMAIL="2802730199@qq.com"

# 获取当前配置的作者信息
AUTHOR_NAME=$(git config user.name)
AUTHOR_EMAIL=$(git config user.email)

# 检查作者名称
if [ "$AUTHOR_NAME" != "$CORRECT_NAME" ]; then
    echo "❌ 提交被拒绝！"
    echo "   当前作者名称: $AUTHOR_NAME"
    echo "   要求作者名称: $CORRECT_NAME"
    echo ""
    echo "请运行以下命令修复："
    echo "   git config user.name \"$CORRECT_NAME\""
    echo "   git config user.email \"$CORRECT_EMAIL\""
    exit 1
fi

# 检查作者邮箱
if [ "$AUTHOR_EMAIL" != "$CORRECT_EMAIL" ]; then
    echo "❌ 提交被拒绝！"
    echo "   当前作者邮箱: $AUTHOR_EMAIL"
    echo "   要求作者邮箱: $CORRECT_EMAIL"
    echo ""
    echo "请运行以下命令修复："
    echo "   git config user.email \"$CORRECT_EMAIL\""
    exit 1
fi

# 检查提交消息中是否包含 Co-Authored-By
COMMIT_MSG_FILE="$1"
if [ -f "$COMMIT_MSG_FILE" ]; then
    if grep -qE "^Co-Authored-By:" "$COMMIT_MSG_FILE"; then
        echo "❌ 提交被拒绝！"
        echo "   提交消息中包含 Co-Authored-By，这是不允许的。"
        echo ""
        echo "请编辑提交消息，删除 Co-Authored-By 行。"
        exit 1
    fi
fi

echo "✅ 作者信息检查通过: $CORRECT_NAME <$CORRECT_EMAIL>"
exit 0
