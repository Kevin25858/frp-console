}

# -------------------- 8. 卸载管理工具 --------------------
uninstall() {
    echo ""
    echo "${BOLD}========== 卸载 FRP Console ==========${RESET}"
    echo ""
    echo "${YELLOW}警告：此操作将卸载 FRP Console 管理控制台。${RESET}"
    echo ""
    echo "${GREEN}以下内容会被保留（不受影响）：${RESET}"
    echo "  - 所有 FRPC-* 容器（继续独立运行）"
    echo "  - /opt/frpc/ 配置文件"
    echo "  - data/ 数据库文件"
    echo "  - logs/ 日志文件"
    echo ""
    echo "${RED}以下内容会被删除：${RESET}"
    echo "  - frp-console 容器"
    echo "  - frp-console 镜像"
    echo ""

    # 二次确认
    read -rp "${RED}确认要卸载吗？输入 yes 继续，其他取消: ${RESET}" confirm
    if [ "$confirm" != "yes" ]; then
        log INFO "已取消卸载"
        return 0
    fi

    echo ""
    log INFO "开始卸载..."

    # 第一步：停止并删除 frp-console 容器
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -q "^${CONTAINER_NAME}$"; then
        log INFO "停止并删除 frp-console 容器..."
        cd "$PROJECT_DIR"
        docker compose down 2>&1 || docker rm -f "$CONTAINER_NAME" 2>/dev/null
        log OK "容器已删除"
    else
        log INFO "未找到 frp-console 容器，跳过"
    fi

    # 第二步：删除 frp-console 镜像
    local image_name
    image_name=$(docker images --format '{{.Repository}}' 2>/dev/null | grep "frp-console" | head -1)
    if [ -n "$image_name" ]; then
        log INFO "删除镜像 $image_name..."
        docker rmi "$image_name" 2>/dev/null || log WARN "镜像删除失败（可能被其他容器引用）"
        log OK "镜像已删除"
    else
        log INFO "未找到 frp-console 镜像，跳过"
    fi

    # 第三步：显示保留的内容
    echo ""
    log OK "卸载完成"
    echo ""
    echo "${GREEN}保留的内容：${RESET}"

    # 显示保留的 FRPC 容器
    local frpc_containers
    frpc_containers=$(docker ps --format '{{.Names}}' 2>/dev/null | grep "^FRPC-" || echo "")
    if [ -n "$frpc_containers" ]; then
        echo "  FRPC 容器（仍在运行）："
        echo "$frpc_containers" | while read -r name; do
            echo "    - $name"
        done
    else
        echo "  FRPC 容器：无"
    fi

    # 显示保留的配置文件
    if [ -d /opt/frpc ]; then
        local config_count
        config_count=$(ls /opt/frpc/frpc-*.toml 2>/dev/null | wc -l)
        echo "  配置文件：/opt/frpc/（${config_count} 个文件）"
    fi

    # 显示保留的数据
    if [ -d "$PROJECT_DIR/data" ]; then
        echo "  数据库：$PROJECT_DIR/data/"
    fi
    if [ -d "$PROJECT_DIR/logs" ]; then
        echo "  日志：$PROJECT_DIR/logs/"
    fi

    echo ""
    echo "${DIM}如需重新安装，请执行：./deploy.sh${RESET}"
    echo "${BOLD}====================================${RESET}"
}

# -------------------- 9. 初始化安装 --------------------
init_install() {
    echo ""
    echo "${BOLD}========== 初始化安装 ==========${RESET}"
    echo ""
    echo "欢迎使用 FRP Console 管理工具"
    echo "首次使用需要设置管理员账号和密码"
    echo ""

    # 检查是否有 .env，没有则从 .env.example 复制
    if [ ! -f "$ENV_FILE" ]; then
        if [ -f "$PROJECT_DIR/.env.example" ]; then
            cp "$PROJECT_DIR/.env.example" "$ENV_FILE"
            log OK "已从 .env.example 创建 .env"
        else
            log ERROR "未找到 .env.example，无法初始化"
            return 1
        fi
    fi

    # 设置用户名
    echo ""
    read -rp "请输入管理员用户名（默认 admin）: " username
    username=$(echo "$username" | tr -d '[:space:]')
    username=${username:-admin}

    # 设置密码
    while true; do
        echo ""
        read -srp "请输入管理员密码（至少 8 位）: " password1
        echo ""
        read -srp "请再次输入密码: " password2
        echo ""

        if [ "$password1" != "$password2" ]; then
            log ERROR "两次输入的密码不一致，请重试"
            continue
        fi

        if [ ${#password1} -lt 8 ]; then
            log ERROR "密码长度不足 8 位，请重试"
            continue
        fi

        if [ -z "$password1" ]; then
            log ERROR "密码不能为空"
            continue
        fi

        break
    done

    # 写入 .env
    log INFO "保存配置..."

    # 更新或添加 ADMIN_USER
    if grep -q '^ADMIN_USER=' "$ENV_FILE"; then
        if [ "$(uname)" = "Darwin" ]; then
            sed -i '' "s/^ADMIN_USER=.*/ADMIN_USER=${username}/" "$ENV_FILE"
        else
            sed -i "s/^ADMIN_USER=.*/ADMIN_USER=${username}/" "$ENV_FILE"
        fi
    else
        echo "ADMIN_USER=${username}" >> "$ENV_FILE"
    fi

    # 更新或添加 ADMIN_PASSWORD
    if grep -q '^ADMIN_PASSWORD=' "$ENV_FILE"; then
        if [ "$(uname)" = "Darwin" ]; then
            sed -i '' "s|^ADMIN_PASSWORD=.*|ADMIN_PASSWORD=${password1}|" "$ENV_FILE"
        else
            sed -i "s|^ADMIN_PASSWORD=.*|ADMIN_PASSWORD=${password1}|" "$ENV_FILE"
        fi
    else
        echo "ADMIN_PASSWORD=${password1}" >> "$ENV_FILE"
    fi

    log OK "账号密码已保存"
    echo ""

    # 询问是否立即部署
    echo "账号设置完成，接下来需要构建并启动服务。"
    read -rp "是否立即部署？(Y/n): " confirm
    if [ -z "$confirm" ] || [ "$confirm" = "Y" ] || [ "$confirm" = "y" ]; then
        log INFO "开始部署..."
        if [ -f "$DEPLOY_SCRIPT" ]; then
            bash "$DEPLOY_SCRIPT"
        else
            log ERROR "未找到 deploy.sh，请手动运行：docker compose up -d --build"
        fi
    else
        log INFO "稍后可运行 ./deploy.sh 完成部署"
    fi
}

# 主菜单（入口）
main_menu() {
    dynamic_menu
}

# ==================== 入口 ====================

# 检查 docker 命令
if ! command -v docker >/dev/null 2>&1; then
    die "未找到 docker 命令，请先安装 Docker"
fi

# 支持命令行参数直接执行（跳过菜单）
if [ $# -gt 0 ]; then
    case "$1" in
        status)         show_status ;;
        start)          start_service ;;
        stop)           stop_service ;;
        restart)        restart_service ;;
        account)        show_account ;;
        reset-password) reset_password ;;
        update)         check_update ;;
        uninstall)      uninstall ;;
        init)           init_install ;;
        register)       register_global ;;
        menu)           main_menu ;;
        *)
            echo "用法: frpw [命令]"
            echo ""
            echo "命令列表："
            echo "  （无参数）       进入交互式菜单"
            echo "  status           查看项目状态"
            echo "  start            启动服务"
            echo "  stop             停止服务"
            echo "  restart          重启服务"
            echo "  account          查看账号信息"
            echo "  reset-password   重置密码"
            echo "  update           检查更新（预留）"
            echo "  uninstall        卸载管理工具"
            echo "  init             初始化安装"
            echo "  register         重新注册全局命令"
            exit 1
            ;;
    esac
    exit 0
fi

# 无参数时：先自动注册全局命令，再进入交互式菜单
register_global
main_menu
